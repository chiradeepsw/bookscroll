# Copy this to .env.local (git-ignored) for local development.

# Your deployed Cloudflare Worker URL (recommended — key stays server-side)
VITE_API_PROXY_URL=https://bookscroll-api.YOUR_NAME.workers.dev

# Only needed if NOT using the proxy (personal/private sites only)
# WARNING: this key will be visible in your compiled JS bundle
# VITE_ANTHROPIC_API_KEY=sk-ant-...
